# F-SOCIETY Environment Variables Override Templates

# Custom Download Directory (defaults to user's home /Downloads/F-SOCIETY)
# F_SOCIETY_DOWNLOAD_DIR="D:/Media/Downloads"

# Speed limits configurations override (e.g. 500K, 2M)
# F_SOCIETY_SPEED_LIMIT="2M"

# Default video download qualities preset (1080p, best)
# F_SOCIETY_VIDEO_QUALITY="1080p"

# Default audio download bitrate preset (320, 192)
# F_SOCIETY_AUDIO_QUALITY="320"

# Sound Alerts and Toast Notification flags (True/False)
# F_SOCIETY_SOUNDS=True
# F_SOCIETY_NOTIFS=True
